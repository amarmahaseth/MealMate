<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_gradient"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Header Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Top Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- App Name -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="  MealMate"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- Profile Menu Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/white">

                        <ImageButton
                            android:id="@+id/profileMenuButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary"
                            android:padding="12dp" />

                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Welcome Section -->
                <LinearLayout
                    android:id="@+id/welcomeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="22dp"
                    android:paddingRight="0dp"
                    android:paddingBottom="24dp">


                <!-- Welcome Text -->
                    <TextView
                        android:id="@+id/userNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Welcome back"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="normal" />

                    <!-- Today's Meals Section -->
                    <LinearLayout
                        android:id="@+id/todaysMealsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="Today's Meals"
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/btnTrackFood"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:background="?attr/selectableItemBackground"
                                android:drawableEnd="@drawable/ic_arrow_forward"
                                android:drawablePadding="4dp"
                                android:drawableTint="@color/white"
                                android:padding="8dp"
                                android:text="Track Food"
                                android:textColor="@color/white"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- ViewSwitcher for Meal Cards -->
                        <ViewSwitcher
                            android:id="@+id/mealCardsViewSwitcher"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp">

                            <!-- Shimmer Layout -->
                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/mealsShimmerLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clipToPadding="false"
                                    android:scrollbars="none">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <!-- Shimmer Meal Card -->
                                        <include layout="@layout/shimmer_meal_card" />
                                        <include layout="@layout/shimmer_meal_card" />
                                        <include layout="@layout/shimmer_meal_card" />
                                        <include layout="@layout/shimmer_meal_card" />

                                    </LinearLayout>
                                </HorizontalScrollView>
                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <!-- Actual Meal Cards -->
                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <!-- Breakfast Card -->
                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/breakfastCard"
                                        android:layout_width="160dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:foreground="?attr/selectableItemBackground"
                                        app:cardBackgroundColor="@color/white"
                                        app:cardCornerRadius="16dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical">

                                            <ImageView
                                                android:id="@+id/breakfastImage"
                                                android:layout_width="match_parent"
                                                android:layout_height="124dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/placeholder_meal" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_margin="12dp"
                                                android:fontFamily="sans-serif-medium"
                                                android:text="Breakfast"
                                                android:textColor="@color/text_primary"
                                                android:textSize="14sp" />
                                        </LinearLayout>
                                    </com.google.android.material.card.MaterialCardView>

                                    <!-- Lunch Card -->
                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/lunchCard"
                                        android:layout_width="160dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:foreground="?attr/selectableItemBackground"
                                        app:cardBackgroundColor="@color/white"
                                        app:cardCornerRadius="16dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical">

                                            <ImageView
                                                android:id="@+id/lunchImage"
                                                android:layout_width="match_parent"
                                                android:layout_height="120dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/placeholder_meal" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_margin="12dp"
                                                android:fontFamily="sans-serif-medium"
                                                android:text="Lunch"
                                                android:textColor="@color/text_primary"
                                                android:textSize="14sp" />
                                        </LinearLayout>
                                    </com.google.android.material.card.MaterialCardView>

                                    <!-- Dinner Card -->
                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/dinnerCard"
                                        android:layout_width="160dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:foreground="?attr/selectableItemBackground"
                                        app:cardBackgroundColor="@color/white"
                                        app:cardCornerRadius="16dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical">

                                            <ImageView
                                                android:id="@+id/dinnerImage"
                                                android:layout_width="match_parent"
                                                android:layout_height="120dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/placeholder_meal" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_margin="12dp"
                                                android:fontFamily="sans-serif-medium"
                                                android:text="Dinner"
                                                android:textColor="@color/text_primary"
                                                android:textSize="14sp" />
                                        </LinearLayout>
                                    </com.google.android.material.card.MaterialCardView>

                                    <!-- Snacks Card -->
                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/snacksCard"
                                        android:layout_width="160dp"
                                        android:layout_height="wrap_content"
                                        android:foreground="?attr/selectableItemBackground"
                                        app:cardBackgroundColor="@color/white"
                                        app:cardCornerRadius="16dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical">

                                            <ImageView
                                                android:id="@+id/snacksImage"
                                                android:layout_width="match_parent"
                                                android:layout_height="120dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/placeholder_meal" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_margin="12dp"
                                                android:fontFamily="sans-serif-medium"
                                                android:text="Snacks"
                                                android:textColor="@color/text_primary"
                                                android:textSize="14sp" />
                                        </LinearLayout>
                                    </com.google.android.material.card.MaterialCardView>

                                </LinearLayout>
                            </HorizontalScrollView>
                        </ViewSwitcher>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/background"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Features Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <!-- Features Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- My Recipes Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/recipesCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E0E0E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/recipe_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="My Recipes"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="View all recipes"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Meal Planner Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/plannerCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E0E0E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/meal_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="Meal Planner"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Plan your meals"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false">

                        <!-- Grocery List Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardGroceryList"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E0E0E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/grocery_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="Grocery List"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Manage groceries"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Geotag Stores Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/storesCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E0E0E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/getog_stores_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="Geotag Stores"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Find nearby stores"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Row 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Shopping Tasks Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/shoppingTasksCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/shopping_task_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="Delegation"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Manage shopping tasks"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Empty space to balance the layout -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddRecipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:text="Add Recipe"
        android:textColor="@color/white"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        app:backgroundTint="@color/primary" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="8dp"
        app:menu="@menu/menu_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>